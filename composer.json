{
    "name": "packitifotech/laragdads",
    "description": "Create ads banners using the GD image library",
    "keywords": ["GD", "GD Ads", "ads", "banner", "thief", "php", "dominant", "palette"],
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ksubileau/color-thief-php": "^2.0",
        "stil/gd-text": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "illuminate/support": "^10.0|^11.0"
    },
    "suggest": {
        "illuminate/support": "Required to save banners to Laravel filesystem disks and for the service provider."
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Packitifotech\\Laragdads\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packitifotech\\Laragdads\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Tushar Sawant",
            "email": "tusharsawant2427@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Packitifotech\\Laragdads\\GdAdsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
